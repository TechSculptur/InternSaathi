# Backend Environment Configuration (Safe Local Defaults)
APP_NAME="Internship Saathi Backend"
APP_ENV="development"
DEBUG=True
HOST="127.0.0.1"
PORT=8000

# SQLite database file path (resolved relative to backend directory if relative)
DATABASE_URL="sqlite:///./data/app.db"

# CORS configuration (comma-separated list of origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Optional: required only for JD-based resume tailoring
GEMINI_API_KEY=
GEMINI_MODEL="gemini-3.8-flash"
